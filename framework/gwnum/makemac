# Makefile for Mac OS X gwnum library
#

# This line was used to make a Mac OS X prime95 that was backward compatible to most OSX versions
# This no longer works as I get error messages that include file <atomic> cannot be found
#ENVP= MACOSX_DEPLOYMENT_TARGET=10.3

SDKPATH=`xcodebuild -version -sdk macosx Path`
VCPKG_DIR = ../../vcpkg/installed/x64-osx

CC = `xcrun -find gcc`
CFLAGS64 = -arch x86_64 -mmacosx-version-min=10.13 -isysroot ${SDKPATH} -I.. -I../sqlite-amalgamation-3420000 -I$(VCPKG_DIR)/include/ -O3 -std=gnu99 -DX86_64 -m64 -fno-exceptions

CPP = `xcrun -find g++`
CPPFLAGS64 = -arch x86_64 -mmacosx-version-min=10.13 -isysroot ${SDKPATH}  -I.. -I../qd -I$(VCPKG_DIR)/include/ -O3 -DX86_64 -std=c++11 -m64 -fno-exceptions -fno-rtti -Wno-stdlibcxx-not-found

AR = `xcrun -find ar`

MACOBJS = cpuid.o gwnum.o gwtables.o gwthread.o gwini.o gwbench.o gwutil.o gwdbldbl.o giants.o radix.o ecmstag1.o
POLYOBJS = polymult.o polymult_sse2.o polymult_avx.o polymult_fma.o polymult_avx512.o

LIB = gwnum.a
POLYLIB = polymult.a

#########################################################################

all:	$(LIB) $(POLYLIB)

$(LIB): $(MACOBJS)
	$(AR) -rs $(LIB) $(MACOBJS)

$(POLYLIB): $(POLYOBJS)
	$(AR) -rs $(POLYLIB) $(POLYOBJS)

clean:
	rm -f $(MACOBJS) $(POLYOBJS)

distclean: clean
	rm -f $(LIB) $(POLYLIB)

polymult_sse2.o: polymult.c polymult.h
	$(ENVP) $(CC) $(CFLAGS64) -DSSE2 -msse2 -c -o polymult_sse2.o polymult.c

polymult_avx.o: polymult.c polymult.h
	$(ENVP) $(CC) $(CFLAGS64) -DAVX -mavx -c -o polymult_avx.o polymult.c

polymult_fma.o: polymult.c polymult.h
	$(ENVP) $(CC) $(CFLAGS64) -DFMA -mfma -c -o polymult_fma.o polymult.c

polymult_avx512.o: polymult.c polymult.h
	$(ENVP) $(CC) $(CFLAGS64) -DAVX512 -mavx512f -c -o polymult_avx512.o polymult.c

.c.o:
	$(ENVP) $(CC) $(CFLAGS64) -c $<

.cpp.o:
	$(ENVP) $(CPP) $(CPPFLAGS64) -c $<

